FROM apache/age:release_PG18_1.7.0

# Build pgaudit + pg_cron (PG18) and compile pgvector v0.8.0 from a
# checksum-pinned tarball. This mirrors the proven .github/actions/setup-pg-age
# steps so the runtime image and the CI database are built identically.
#
# DEBIAN_FRONTEND=noninteractive + --force-confold keep apt from stopping the
# build on a config-file prompt. We use `upgrade` (not `dist-upgrade`) to patch
# CVEs without the dependency churn that can break a freshly cut base image,
# and a curl tarball (not git clone) so the build consumes only a checksum-
# pinned input and carries no git in the final layer.
ARG PGVECTOR_TAG=v0.8.0
ARG PGVECTOR_SHA256=867a2c328d4928a5a9d6f052cd3bc78c7d60228a9b914ad32aa3db88e9de27b0
RUN export DEBIAN_FRONTEND=noninteractive \
    && apt-get update -qq \
    && apt-get -y -o Dpkg::Options::="--force-confold" upgrade \
    && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
        ca-certificates \
        postgresql-server-dev-18 \
        postgresql-18-cron \
        postgresql-18-pgaudit \
    && mkdir -p /tmp/pgvector \
    && curl -fsSL -o /tmp/pgvector.tar.gz \
        "https://github.com/pgvector/pgvector/archive/refs/tags/${PGVECTOR_TAG}.tar.gz" \
    && echo "${PGVECTOR_SHA256}  /tmp/pgvector.tar.gz" | sha256sum -c - \
    && tar xz -C /tmp/pgvector --strip-components=1 -f /tmp/pgvector.tar.gz \
    && rm /tmp/pgvector.tar.gz \
    && cd /tmp/pgvector \
    && make \
    && make install \
    && cd / \
    && rm -rf /tmp/pgvector \
    # Drop the build toolchain — not needed at runtime and otherwise the
    # dominant CVE surface of the final image.
    && apt-get purge -y --auto-remove \
        build-essential \
        curl \
        postgresql-server-dev-18 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Copy migrations for initdb
COPY schema/migrations/ /docker-entrypoint-initdb.d/migrations/
COPY schema/seed/ /docker-entrypoint-initdb.d/seed/
COPY deploy/docker/initdb.sh /docker-entrypoint-initdb.d/99-run-migrations.sh
RUN chmod +x /docker-entrypoint-initdb.d/99-run-migrations.sh
