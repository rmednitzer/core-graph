FROM apache/age:release_PG16_1.6.0

# Pull OS-level security patches into the image. The apache/age base
# image is updated infrequently and accumulates fixable CRITICAL CVEs
# between rebuilds; without `apt-get upgrade` Trivy fails the security
# workflow on whatever the base happens to ship that week. This matches
# the pattern already in Dockerfile.app.
RUN apt-get update -qq \
    && apt-get upgrade -y --no-install-recommends \
    && apt-get install -y --no-install-recommends \
        build-essential \
        git \
        postgresql-server-dev-16 \
        postgresql-16-cron \
        postgresql-16-pgaudit \
        ca-certificates \
    && git clone --branch v0.7.4 https://github.com/pgvector/pgvector.git /tmp/pgvector \
    && cd /tmp/pgvector \
    && make \
    && make install \
    && cd / \
    && rm -rf /tmp/pgvector \
    # Remove build toolchain after pgvector is installed — it isn't
    # needed at runtime and dragging it along grows the CVE surface.
    && apt-get purge -y --auto-remove \
        build-essential \
        git \
        postgresql-server-dev-16 \
    && rm -rf /var/lib/apt/lists/*

# Copy migrations for initdb
COPY schema/migrations/ /docker-entrypoint-initdb.d/migrations/
COPY schema/seed/ /docker-entrypoint-initdb.d/seed/
COPY deploy/docker/initdb.sh /docker-entrypoint-initdb.d/99-run-migrations.sh
RUN chmod +x /docker-entrypoint-initdb.d/99-run-migrations.sh
