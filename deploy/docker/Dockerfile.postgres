FROM apache/age:release_PG16_1.6.0

# Pull OS-level security patches into the image. The apache/age base
# is updated infrequently and accumulates fixable CRITICAL CVEs between
# rebuilds; `dist-upgrade` is needed (not `upgrade`) because some PG16
# security patches change package dependencies and `upgrade` holds them
# back. Mirrors the spirit of the patch in Dockerfile.app.
RUN apt-get update -qq \
    && apt-get dist-upgrade -y \
    && apt-get install -y --no-install-recommends \
        build-essential \
        git \
        postgresql-server-dev-16 \
        postgresql-16-cron \
        postgresql-16-pgaudit \
        ca-certificates \
    # pgvector is built from source. Bumping past v0.7.4 picks up
    # the upstream security and correctness fixes shipped in the v0.8
    # line.
    && git clone --branch v0.8.0 --depth 1 https://github.com/pgvector/pgvector.git /tmp/pgvector \
    && cd /tmp/pgvector \
    && make \
    && make install \
    && cd / \
    && rm -rf /tmp/pgvector \
    # Drop build toolchain after pgvector is installed — it isn't
    # needed at runtime and would otherwise dominate the CVE surface
    # area of the final image.
    && apt-get purge -y --auto-remove \
        build-essential \
        git \
        postgresql-server-dev-16 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Copy migrations for initdb
COPY schema/migrations/ /docker-entrypoint-initdb.d/migrations/
COPY schema/seed/ /docker-entrypoint-initdb.d/seed/
COPY deploy/docker/initdb.sh /docker-entrypoint-initdb.d/99-run-migrations.sh
RUN chmod +x /docker-entrypoint-initdb.d/99-run-migrations.sh
