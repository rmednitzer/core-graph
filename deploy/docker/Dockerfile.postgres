FROM apache/age:release_PG18_1.7.0@sha256:e7de1717e487dac7c1be93a1cd5360a2cf07ff4170342c2af2ac4713c21baf00

# Build pgaudit + pg_cron (PG18) and compile pgvector from a checksum-pinned
# tarball. Mirrors the .github/actions/setup-pg-age steps so the runtime image
# and the CI database are built identically.
#
# pgvector 0.8.2 is the first 0.8.x release with PostgreSQL 18 support — 0.8.0
# predates PG18 and fails to compile against the PG18 server headers.
#
# DEBIAN_FRONTEND=noninteractive + --force-confold keep apt from stopping the
# build on a config-file prompt; `dist-upgrade` pulls CVE fixes even when they
# change dependencies; a curl tarball (not git clone) lets the build consume
# only a checksum-pinned input and carry no git in the final layer.
ARG PGVECTOR_TAG=v0.8.2
ARG PGVECTOR_SHA256=69f4019389af05dc1c9548deb8628e62878e6e207c03907f2b8af2016472cdaa
RUN export DEBIAN_FRONTEND=noninteractive \
    && apt-get update -qq \
    && apt-get -y -o Dpkg::Options::="--force-confold" dist-upgrade \
    && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
        ca-certificates \
        postgresql-server-dev-18 \
        postgresql-18-cron \
        postgresql-18-pgaudit \
    && mkdir -p /tmp/pgvector \
    # --retry-all-errors because the observed failures are curl 56 ("Connection
    # died") and curl 22 (503), a transport error and a server error, and plain
    # --retry covers neither reliably on its own.
    #
    # No --retry-delay: setting it pins every attempt at a fixed interval and
    # disables curl's exponential backoff. Backoff is what is wanted here, since
    # the failure being absorbed is an upstream incident lasting minutes rather
    # than a single dropped packet. --retry-max-time bounds the whole thing, so
    # a genuine outage still fails the build instead of hanging it.
    #
    # Retrying is safe precisely because the next line verifies the checksum: a
    # truncated or substituted body fails there, not here.
    && curl -fsSL --retry 8 --retry-all-errors --retry-max-time 180 -o /tmp/pgvector.tar.gz \
        "https://github.com/pgvector/pgvector/archive/refs/tags/${PGVECTOR_TAG}.tar.gz" \
    && echo "${PGVECTOR_SHA256}  /tmp/pgvector.tar.gz" | sha256sum -c - \
    && tar xz -C /tmp/pgvector --strip-components=1 -f /tmp/pgvector.tar.gz \
    && rm /tmp/pgvector.tar.gz \
    && cd /tmp/pgvector \
    && make \
    && make install \
    && cd / \
    && rm -rf /tmp/pgvector \
    # Drop the build toolchain — not needed at runtime and otherwise the
    # dominant CVE surface of the final image.
    && apt-get purge -y --auto-remove \
        build-essential \
        curl \
        postgresql-server-dev-18 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Copy migrations for initdb
COPY schema/migrations/ /docker-entrypoint-initdb.d/migrations/
COPY schema/seed/ /docker-entrypoint-initdb.d/seed/
COPY deploy/docker/initdb.sh /docker-entrypoint-initdb.d/99-run-migrations.sh
RUN chmod +x /docker-entrypoint-initdb.d/99-run-migrations.sh
